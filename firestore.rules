rules_version = '2';

// Only you (signed in with the one account you create in Firebase Auth)
// can read or write cards. Everyone else gets denied, even though the
// Pages URL and the Firebase config are public.
//
// After creating your user in Firebase Console > Authentication,
// copy its UID from there and paste it below.

service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{cardId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == "WE6lJ1TxR0e1dyVFfELWHyxfD8i2";
    }
  }
}
